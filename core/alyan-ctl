    p_xdel = sub.add_parser("xray-del")
    p_xdel.add_argument("--uuid", required=True)

    p_set = sub.add_parser("settings")
    p_set.add_argument("--json", required=True)

    p_login = sub.add_parser("admin-login")
    p_login.add_argument("--username", required=True)
    p_login.add_argument("--password", required=True)

