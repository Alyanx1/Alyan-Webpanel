# ─── Password Hashing (Pure Stdlib PBKDF2-SHA256) ────────────────────────────
def hash_password(password: str) -> str:
    salt = secrets.token_hex(16)
    dk = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("utf-8"), 260000)
    return f"pbkdf2_sha256$260000${salt}${dk.hex()}"


def verify_password(password: str, stored: str) -> bool:
    try:
        algo, iters, salt, digest = stored.split("$", 3)
        if algo != "pbkdf2_sha256":
            return False
        dk = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("utf-8"), int(iters))
        return hmac.compare_digest(dk.hex(), digest)
    except Exception:
        return False


# ─── SQLite Connection & Schema ──────────────────────────────────────────────
def get_db() -> sqlite3.Connection:
    VAR_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH), timeout=15.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA foreign_keys=ON;")
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS settings (
            key   TEXT PRIMARY KEY,
            value TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS admins (
            username     TEXT PRIMARY KEY,
            pass_hash    TEXT NOT NULL,
            role         TEXT NOT NULL DEFAULT 'admin',
            max_accounts INTEGER NOT NULL DEFAULT 0,
            scope        TEXT NOT NULL DEFAULT 'own',
            status       TEXT NOT NULL DEFAULT 'active',
            last_login   TEXT NOT NULL DEFAULT 'Never',
            created      TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS ssh_users (
            username   TEXT PRIMARY KEY,
            password   TEXT NOT NULL,
            used_bytes INTEGER NOT NULL DEFAULT 0,
            gb_limit   REAL NOT NULL DEFAULT 0,
            ip_limit   INTEGER NOT NULL DEFAULT 0,
            expiry     TEXT NOT NULL,
            status     TEXT NOT NULL DEFAULT 'active',
            owner      TEXT NOT NULL DEFAULT 'admin',
            created    TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS xray_users (
            uuid       TEXT PRIMARY KEY,
            username   TEXT NOT NULL,
            proto      TEXT NOT NULL,
            used_bytes INTEGER NOT NULL DEFAULT 0,
            gb_limit   REAL NOT NULL DEFAULT 0,
            ip_limit   INTEGER NOT NULL DEFAULT 0,
            expiry     TEXT NOT NULL,
            status     TEXT NOT NULL DEFAULT 'active',
            owner      TEXT NOT NULL DEFAULT 'admin',
            created    TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS audit_log (
            id         INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at TEXT NOT NULL,
            actor      TEXT NOT NULL,
            action     TEXT NOT NULL,
            detail     TEXT NOT NULL,
            ip         TEXT NOT NULL DEFAULT 'local'
        );
        """
    )
    conn.execute("UPDATE admins SET scope = 'all' WHERE role = 'viewer';")
    conn.commit()
    return conn


def get_setting(conn: sqlite3.Connection, key: str, default: str = "") -> str:
    row = conn.execute("SELECT value FROM settings WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else default


def set_setting(conn: sqlite3.Connection, key: str, value: str):
    conn.execute(
        "INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (key, str(value)),
    )


def add_audit(conn: sqlite3.Connection, actor: str, action: str, detail: str, ip: str = "local"):
    conn.execute(
        "INSERT INTO audit_log (created_at, actor, action, detail, ip) VALUES (?, ?, ?, ?, ?)",
        (dt.datetime.now().strftime("%H:%M:%S"), actor, action, detail, ip),
    )


# ─── System Metadata & SSL Helpers ───────────────────────────────────────────
def ssl_days_remaining() -> int:
    cert = SSL_DIR / "fullchain.pem"
    if not cert.exists():
        return 0
    try:
        mtime = cert.stat().st_mtime
        if SSL_CACHE.exists():
            cached = json.loads(SSL_CACHE.read_text(encoding="utf-8"))
            if cached.get("mtime") == mtime and (time.time() - float(cached.get("ts", 0))) < 3600:
                return int(cached["days"])
        out = subprocess.check_output(
            ["openssl", "x509", "-enddate", "-noout", "-in", str(cert)],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        # notAfter=Jan 28 06:00:00 2027 GMT
        dt_str = out.split("=", 1)[1].strip()
        exp = dt.datetime.strptime(dt_str, "%b %d %H:%M:%S %Y %Z")
        days = max(0, (exp - dt.datetime.utcnow()).days)
        try:
            SSL_CACHE.write_text(json.dumps({"mtime": mtime, "ts": time.time(), "days": days}), encoding="utf-8")
        except Exception:
            pass
        return days
    except Exception:
        return 89


def system_uptime_human() -> str:
    try:
        secs = int(float(Path("/proc/uptime").read_text().split()[0]))
        d, rem = divmod(secs, 86400)
        h, rem = divmod(rem, 3600)
        m, _ = divmod(rem, 60)
        return f"{d}d {h}h {m}m" if d else f"{h}h {m}m"
    except Exception:
        return "0h 1m"


def detect_os_and_cpu() -> tuple[str, str, str]:
    os_name = "Ubuntu Linux"
    try:
        for ln in Path("/etc/os-release").read_text().splitlines():
            if ln.startswith("PRETTY_NAME="):
                os_name = ln.split("=", 1)[1].strip().strip('"')
                break
    except Exception:
        pass
    kernel = f"{os.uname().release} ({os.uname().machine})"
    cpu_model = "vCPU"
    cores = os.cpu_count() or 1
    try:
        for ln in Path("/proc/cpuinfo").read_text().splitlines():
            if "model name" in ln or "Model" in ln:
                cpu_model = ln.split(":", 1)[1].strip()
                break
    except Exception:
        pass
    return os_name, kernel, f"{cpu_model} · {cores} vCPU"


def build_cfg_dict(conn: sqlite3.Connection) -> dict:
    os_name, kernel, cpu_model = detect_os_and_cpu()
    bot = json.loads(get_setting(conn, "bot_json", '{"enabled":false,"token":"","admin_id":"","alerts":true}'))
    return {
        "domain": get_setting(conn, "domain", "localhost"),
        "panel_port": int(get_setting(conn, "panel_port", "8443")),
        "ssl_days": ssl_days_remaining(),
        "ip": get_setting(conn, "ip", "127.0.0.1"),
        "location": get_setting(conn, "location", "Cloud Edge"),
        "provider": get_setting(conn, "provider", "Dedicated VPS"),
        "os": os_name,
        "kernel": kernel,
        "cpu_model": cpu_model,
        "uptime": system_uptime_human(),
        "ws_path": "/alyan",
        "banner": get_setting(conn, "banner", ""),
        "bot": bot,
    }


# ─── Wire-Speed Kernel Tuning, Unthrottled NIC & Config Rendering ────────────
def apply_kernel_network_tuning(iface: str = "eth0"):
    """
    Remove all artificial tc/CAKE/HTB bandwidth caps & shapers, activate Linux BBR + FQ
    packet pacing immediately on the live NIC, eliminate mid-session cwnd drops, and
    tune socket buffers + worker file descriptors for 100% native line-rate & flat ping.
    """
    # 1. Stop & remove any legacy alyan-qos shaper unit or config
    subprocess.run(["systemctl", "stop", "alyan-qos"], stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "disable", "alyan-qos"], stderr=subprocess.DEVNULL)
    for stale_path in (
        Path("/etc/systemd/system/alyan-qos.service"),
        ETC_DIR / "qos.json",
        Path("/etc/sysctl.d/99-alyan-bbr.conf"),
    ):
        stale_path.unlink(missing_ok=True)

    # 2. Detect live default NIC + configured NIC, wipe any root/ingress shapers, and attach native 'fq'
    ifaces = {iface.strip() or "eth0"}
    try:
        rt = subprocess.check_output(["ip", "route", "get", "1.1.1.1"], text=True, stderr=subprocess.DEVNULL, timeout=3)
        parts = rt.split()
        if "dev" in parts:
            idx = parts.index("dev")
            if idx + 1 < len(parts):
                ifaces.add(parts[idx + 1])
    except Exception:
        pass

    for dev in ifaces:
        subprocess.run(["tc", "qdisc", "del", "dev", dev, "root"], stderr=subprocess.DEVNULL)
        subprocess.run(["tc", "qdisc", "del", "dev", dev, "ingress"], stderr=subprocess.DEVNULL)
        subprocess.run(["tc", "qdisc", "replace", "dev", dev, "root", "fq"], stderr=subprocess.DEVNULL)
        subprocess.run(["ip", "link", "set", "dev", dev, "txqueuelen", "10000"], stderr=subprocess.DEVNULL)
    subprocess.run(["ip", "link", "del", "ifb0"], stderr=subprocess.DEVNULL)

    # 3. Write full wire-speed + anti-drop + low-bufferbloat sysctl profile
    subprocess.run(["modprobe", "tcp_bbr"], stderr=subprocess.DEVNULL)
    sysctl_dir = Path("/etc/sysctl.d")
    sysctl_dir.mkdir(parents=True, exist_ok=True)
    (sysctl_dir / "99-alyan-turbo.conf").write_text(
        "\n".join(
            [
                "# Alyan Webpanel — Native Wire-Speed + Stable Ping Kernel Profile",
                "fs.file-max = 2097152",
                "net.core.default_qdisc = fq",
                "net.ipv4.tcp_congestion_control = bbr",
                "net.core.somaxconn = 65535",
                "net.core.netdev_max_backlog = 65536",
                "net.core.optmem_max = 25165824",
                "net.core.rmem_default = 262144",
                "net.core.wmem_default = 262144",
                "net.core.rmem_max = 33554432",
                "net.core.wmem_max = 33554432",
                "net.ipv4.tcp_rmem = 4096 131072 33554432",
                "net.ipv4.tcp_wmem = 4096 65536 33554432",
                "net.ipv4.udp_rmem_min = 16384",
                "net.ipv4.udp_wmem_min = 16384",
                "net.ipv4.tcp_notsent_lowat = 16384",
                "net.ipv4.tcp_slow_start_after_idle = 0",
                "net.ipv4.tcp_mtu_probing = 1",
                "net.ipv4.tcp_fastopen = 3",
                "net.ipv4.tcp_tw_reuse = 1",
                "net.ipv4.tcp_fin_timeout = 15",
                "net.ipv4.tcp_max_syn_backlog = 65536",
                "net.ipv4.tcp_max_tw_buckets = 2000000",
                "net.ipv4.ip_local_port_range = 10240 65535",
                "net.ipv4.tcp_keepalive_time = 60",
                "net.ipv4.tcp_keepalive_intvl = 10",
                "net.ipv4.tcp_keepalive_probes = 6",
                "",
            ]
        ),
        encoding="utf-8",
    )
    subprocess.run(["sysctl", "--system"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 4. Raise Nginx & HAProxy file-descriptor & worker_connections limits so multiplexed streams never choke
    for daemon in ("nginx", "haproxy"):
        d_ovr = Path(f"/etc/systemd/system/{daemon}.service.d")
        d_ovr.mkdir(parents=True, exist_ok=True)
        (d_ovr / "alyan-limits.conf").write_text("[Service]\nLimitNOFILE=1048576\n", encoding="utf-8")

    ng_main = Path("/etc/nginx/nginx.conf")
    if ng_main.exists():
        try:
            ng_txt = ng_main.read_text(encoding="utf-8", errors="ignore")
            orig = ng_txt
            if "worker_rlimit_nofile" not in ng_txt:
                ng_txt = re.sub(
                    r"(worker_processes\s+[^;]+;)",
                    r"\1\nworker_rlimit_nofile 65535;",
                    ng_txt,
                    count=1,
                )
            ng_txt = re.sub(r"worker_connections\s+\d+\s*;", "worker_connections 32768;", ng_txt)
            ng_txt = re.sub(r"#\s*multi_accept\s+on\s*;", "multi_accept on;", ng_txt)
            if ng_txt != orig:
                ng_main.write_text(ng_txt, encoding="utf-8")
        except Exception:
            pass


def configure_dropbear_and_banner(banner_text: str):
    ETC_DIR.mkdir(parents=True, exist_ok=True)
    BANNER_FILE.write_text(banner_text or "", encoding="utf-8")

    # Configure /etc/default/dropbear + systemd override for Ubuntu 22.04 & 24.04 compatibility
    Path("/etc/default/dropbear").write_text(
        'NO_START=0\nDROPBEAR_PORT=109\nDROPBEAR_EXTRA_ARGS="-p 143 -b /etc/alyan/banner.txt -w -K 30 -I 600"\nDROPBEAR_BANNER="/etc/alyan/banner.txt"\n',
        encoding="utf-8",
    )
    ovr_dir = Path("/etc/systemd/system/dropbear.service.d")
    ovr_dir.mkdir(parents=True, exist_ok=True)
    db_bin = shutil.which("dropbear") or "/usr/sbin/dropbear"
    (ovr_dir / "alyan.conf").write_text(
        f"[Service]\nLimitNOFILE=1048576\nExecStart=\nExecStart={db_bin} -EF -p 109 -p 143 -b /etc/alyan/banner.txt -w -K 30 -I 600\n",
        encoding="utf-8",
    )

    sshd_cfg = Path("/etc/ssh/sshd_config")
    if sshd_cfg.exists():
        txt = sshd_cfg.read_text(encoding="utf-8", errors="ignore")
        if "Banner /etc/alyan/banner.txt" not in txt:
            txt = re.sub(r"^#?\s*Banner\s+.*$", "", txt, flags=re.MULTILINE)
            txt = txt.rstrip() + "\nBanner /etc/alyan/banner.txt\n"
            sshd_cfg.write_text(txt, encoding="utf-8")
            subprocess.run(["systemctl", "reload", "ssh"], stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "reload", "sshd"], stderr=subprocess.DEVNULL)


def sync_xray_config(conn: sqlite3.Connection, reload_service: bool = True):
    tpl_path = TPL_DIR / "xray-config.json.tpl"
    if not tpl_path.exists():
        return
    rows = conn.execute("SELECT * FROM xray_users WHERE status = 'active'").fetchall()
    vless_c, vmess_c, trojan_c = [], [], []
    for r in rows:
        email = f"{r['username']}.{r['proto']}@alyan"
        if r["proto"] == "vless":
            vless_c.append({"id": r["uuid"], "email": email, "level": 0})
        elif r["proto"] == "vmess":
            vmess_c.append({"id": r["uuid"], "alterId": 0, "email": email, "level": 0})
        elif r["proto"] == "trojan":
            trojan_c.append({"password": r["uuid"], "email": email, "level": 0})

    rendered = (
        tpl_path.read_text(encoding="utf-8")
        .replace("{{VLESS_CLIENTS}}", json.dumps(vless_c))
        .replace("{{VMESS_CLIENTS}}", json.dumps(vmess_c))
        .replace("{{TROJAN_CLIENTS}}", json.dumps(trojan_c))
    )
    out_dir = Path("/usr/local/etc/xray")
    out_dir.mkdir(parents=True, exist_ok=True)
    Path("/var/log/xray").mkdir(parents=True, exist_ok=True)

    xray_bin = Path("/usr/local/bin/xray")
    tmp_cfg = out_dir / ".config.test.json"
    if xray_bin.exists():
        tmp_cfg.write_text(rendered, encoding="utf-8")
        chk = subprocess.run(
            [str(xray_bin), "run", "-test", "-config", str(tmp_cfg)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if chk.returncode != 0 and "trustedXForwardedFor" in rendered:
            try:
                cfg_obj = json.loads(rendered)
                for inb in cfg_obj.get("inbounds", []):
                    so = inb.get("streamSettings", {}).get("sockopt", {})
                    so.pop("trustedXForwardedFor", None)
                rendered = json.dumps(cfg_obj, indent=2)
            except Exception:
                pass
        tmp_cfg.unlink(missing_ok=True)

    (out_dir / "config.json").write_text(rendered, encoding="utf-8")
    if reload_service:
        subprocess.run(["systemctl", "restart", "xray"], stderr=subprocess.DEVNULL)


def render_all_configs(conn: sqlite3.Connection, reload_daemons: bool = False):
    domain = get_setting(conn, "domain", "localhost")
    panel_port = get_setting(conn, "panel_port", "8443")
    banner = get_setting(conn, "banner", "")
    iface = get_setting(conn, "iface", "eth0")

    Path("/var/www/alyan-acme/.well-known/acme-challenge").mkdir(parents=True, exist_ok=True)
    apply_kernel_network_tuning(iface)
    configure_dropbear_and_banner(banner)

    # Ensure HAProxy combined PEM exists
    SSL_DIR.mkdir(parents=True, exist_ok=True)
    fc = SSL_DIR / "fullchain.pem"
    pk = SSL_DIR / "privkey.pem"
    hp = SSL_DIR / "haproxy.pem"
    if fc.exists() and pk.exists():
        hp.write_text(fc.read_text() + "\n" + pk.read_text(), encoding="utf-8")
        os.chmod(hp, 0o600)

    # HAProxy
    hap_tpl = TPL_DIR / "haproxy.cfg.tpl"
    if hap_tpl.exists():
        Path("/etc/haproxy").mkdir(parents=True, exist_ok=True)
        Path("/var/lib/haproxy").mkdir(parents=True, exist_ok=True)
        Path("/run/haproxy").mkdir(parents=True, exist_ok=True)
        Path("/etc/haproxy/haproxy.cfg").write_text(
            hap_tpl.read_text(encoding="utf-8").replace("{{DOMAIN}}", domain),
            encoding="utf-8",
        )

    # Nginx (remove default :80 site so HAProxy owns :80 cleanly)
    for stale in ("/etc/nginx/sites-enabled/default", "/etc/nginx/conf.d/default.conf"):
        p = Path(stale)
        if p.exists() or p.is_symlink():
            p.unlink(missing_ok=True)

    Path("/etc/nginx/conf.d").mkdir(parents=True, exist_ok=True)
    nr_tpl = TPL_DIR / "nginx-router.conf.tpl"
    if nr_tpl.exists():
        Path("/etc/nginx/conf.d/alyan-router.conf").write_text(
            nr_tpl.read_text(encoding="utf-8").replace("{{DOMAIN}}", domain),
            encoding="utf-8",
        )
    np_tpl = TPL_DIR / "nginx-panel.conf.tpl"
    if np_tpl.exists():
        Path("/etc/nginx/conf.d/alyan-panel.conf").write_text(
            np_tpl.read_text(encoding="utf-8")
            .replace("{{DOMAIN}}", domain)
            .replace("{{PANEL_PORT}}", str(panel_port)),
            encoding="utf-8",
        )

    sync_xray_config(conn, reload_service=reload_daemons)

    if reload_daemons:
        subprocess.run(["systemctl", "daemon-reload"], stderr=subprocess.DEVNULL)
        for svc in ("dropbear", "alyan-wsd", "nginx", "haproxy"):
            subprocess.run(["systemctl", "restart", svc], stderr=subprocess.DEVNULL)


# ─── SSL Issuance & Renewal (acme.sh Let's Encrypt EC-256) ───────────────────
def find_acme_bin() -> Path | None:
    candidates = [
        Path("/root/.acme.sh/acme.sh"),
        Path.home() / ".acme.sh" / "acme.sh",
    ]
    for c in candidates:
        if c.exists():
            return c
    return None


def issue_ssl(conn: sqlite3.Connection, standalone: bool = False) -> dict:
    domain = get_setting(conn, "domain", "").strip().lower()
    if not domain or domain in ("localhost", "127.0.0.1"):
        raise ValueError("Configure a valid FQDN domain before issuing Let's Encrypt SSL")

    acme = find_acme_bin()
    if not acme:
        subprocess.run(
            ["bash", "-c", f"curl -fsSL https://get.acme.sh | sh -s email=ssl@{domain}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        acme = find_acme_bin()
    if not acme:
        raise RuntimeError("acme.sh is not installed and could not be downloaded")

    subprocess.run(
        [str(acme), "--set-default-ca", "--server", "letsencrypt"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    webroot = Path("/var/www/alyan-acme")
    (webroot / ".well-known" / "acme-challenge").mkdir(parents=True, exist_ok=True)

    issued = False
    if not standalone:
        res = subprocess.run(
            [str(acme), "--issue", "-d", domain, "-w", str(webroot), "--keylength", "ec-256", "--force"],
            capture_output=True,
            text=True,
        )
        issued = res.returncode == 0 or "Cert success" in (res.stdout + res.stderr)

    if not issued:
        hap_was_active = subprocess.run(["systemctl", "is-active", "--quiet", "haproxy"]).returncode == 0
        if hap_was_active:
            subprocess.run(["systemctl", "stop", "haproxy"], stderr=subprocess.DEVNULL)
        try:
            res = subprocess.run(
                [str(acme), "--issue", "--standalone", "-d", domain, "--keylength", "ec-256", "--force"],
                capture_output=True,
                text=True,
            )
            issued = res.returncode == 0 or "Cert success" in (res.stdout + res.stderr)
        finally:
            if hap_was_active:
                subprocess.run(["systemctl", "start", "haproxy"], stderr=subprocess.DEVNULL)

    SSL_DIR.mkdir(parents=True, exist_ok=True)
    fc = SSL_DIR / "fullchain.pem"
    pk = SSL_DIR / "privkey.pem"
    hp = SSL_DIR / "haproxy.pem"

    if issued:
        subprocess.run(
            [
                str(acme),
                "--install-cert",
                "-d",
                domain,
                "--ecc",
                "--key-file",
                str(pk),
                "--fullchain-file",
                str(fc),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    if fc.exists() and pk.exists():
        hp.write_text(fc.read_text(encoding="utf-8") + "\n" + pk.read_text(encoding="utf-8"), encoding="utf-8")
        os.chmod(fc, 0o600)
        os.chmod(pk, 0o600)
        os.chmod(hp, 0o600)

    for svc in ("nginx", "haproxy"):
        if subprocess.run(["systemctl", "is-active", "--quiet", svc]).returncode == 0:
            subprocess.run(["systemctl", "reload", svc], stderr=subprocess.DEVNULL)

    return {"ok": issued, "domain": domain, "ssl_days": ssl_days_remaining()}


# ─── RBAC & Quota Enforcement Helpers ────────────────────────────────────────
def resolve_actor(conn: sqlite3.Connection, actor: str) -> dict:
    if not actor or actor in ("root", "cli", "system", "telegram"):
        return {"username": actor or "root", "role": "super", "max_accounts": 0, "scope": "all", "status": "active"}
    row = conn.execute("SELECT * FROM admins WHERE username = ?", (actor,)).fetchone()
    if not row:
        return {"username": actor, "role": "super", "max_accounts": 0, "scope": "all", "status": "active"}
    return dict(row)


def check_write_permission(conn: sqlite3.Connection, actor_info: dict, creating: bool = False):
    if actor_info.get("status") != "active":
        raise PermissionError("Admin account is disabled")
    role = actor_info.get("role", "viewer")
    if role == "viewer":
        raise PermissionError("Viewer role is read-only")
    if creating and role != "super":
        max_acc = int(actor_info.get("max_accounts") or 0)
        if max_acc > 0:
            owner = actor_info["username"]
            c_ssh = conn.execute("SELECT COUNT(*) AS c FROM ssh_users WHERE owner = ?", (owner,)).fetchone()["c"]
            c_xry = conn.execute("SELECT COUNT(*) AS c FROM xray_users WHERE owner = ?", (owner,)).fetchone()["c"]
            if (c_ssh + c_xry) >= max_acc:
                raise PermissionError(f"Reseller quota reached ({max_acc} accounts maximum)")


def can_access_owner(actor_info: dict, record_owner: str) -> bool:
    if actor_info.get("role") in ("super", "viewer") or actor_info.get("scope") == "all":
        return True
    return record_owner == actor_info.get("username")


# ─── Live Telemetry, Daemons & Socket Inspection ─────────────────────────────
def read_live_snapshot() -> dict:
    if LIVE_SNAP.exists():
        try:
            return json.loads(LIVE_SNAP.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {}


def instant_host_metrics(iface: str) -> dict:
    # Memory
    mem_total = 1024 * 1048576
    mem_avail = 512 * 1048576
    try:
        vals = {}
        for ln in Path("/proc/meminfo").read_text().splitlines():
            parts = ln.split(":")
            if len(parts) == 2:
                vals[parts[0].strip()] = int(parts[1].strip().split()[0]) * 1024
        mem_total = vals.get("MemTotal", mem_total)
        mem_avail = vals.get("MemAvailable", vals.get("MemFree", mem_avail))
    except Exception:
        pass
    mem_used = max(0, mem_total - mem_avail)
    ram_pct = int(round((mem_used / max(1, mem_total)) * 100))

    # Disk
    try:
        du = shutil.disk_usage("/")
        disk_total, disk_used = du.total, du.used
        disk_pct = int(round((disk_used / max(1, disk_total)) * 100))
    except Exception:
        disk_total, disk_used, disk_pct = 80 * 1073741824, 8 * 1073741824, 10

    # Loadavg
    load_str = "0.10 · 0.12 · 0.09"
    cpu_pct = 6
    try:
        la = Path("/proc/loadavg").read_text().split()[:3]
        load_str = " · ".join(la)
        cores = max(1, os.cpu_count() or 1)
        cpu_pct = min(99, max(2, int(round((float(la[0]) / cores) * 100))))
    except Exception:
        pass

    # Network totals fallback
    rx_tot, tx_tot = 0, 0
    try:
        for ln in Path("/proc/net/dev").read_text().splitlines()[2:]:
            if ":" not in ln:
                continue
            name, rest = ln.split(":", 1)
            name = name.strip()
            if name == "lo":
                continue
            cols = rest.split()
            if name == iface or rx_tot == 0:
                rx_tot = int(cols[0])
                tx_tot = int(cols[8])
                if name == iface:
                    break
    except Exception:
        pass

    return {
        "cpu_pct": cpu_pct,
        "load": load_str,
        "ram_pct": ram_pct,
        "ram_used": mem_used,
        "ram_total": mem_total,
        "disk_pct": disk_pct,
        "disk_used": disk_used,
        "disk_total": disk_total,
        "rx_total": rx_tot,
        "tx_total": tx_tot,
    }


def fmt_mem(mem_bytes: int) -> str:
    if mem_bytes <= 0 or mem_bytes >= (1 << 60):
        return "—"
    mb = mem_bytes / 1048576.0
    if mb >= 1024:
        return f"{mb / 1024.0:.1f} GB"
    return f"{mb:.1f} MB"


def fmt_mono_uptime(enter_usec: int) -> str:
    if enter_usec <= 0:
        return "—"
    try:
        mono_now = int(time.monotonic() * 1_000_000)
        secs = max(0, (mono_now - enter_usec) // 1_000_000)
        d, rem = divmod(secs, 86400)
        h, rem = divmod(rem, 3600)
        m, _ = divmod(rem, 60)
        if d > 0:
            return f"{d}d {h}h"
        if h > 0:
            return f"{h}h {m}m"
        return f"{max(1, m)}m"
    except Exception:
        return "active"


def collect_services() -> list[dict]:
    unit_ids = [s[0] for s in MANAGED_SERVICES]
    props_by_id: dict[str, dict[str, str]] = {u: {} for u in unit_ids}
    try:
        out = subprocess.check_output(
            [
                "systemctl",
                "show",
                *unit_ids,
                "--property=Id,ActiveState,SubState,MemoryCurrent,ActiveEnterTimestampMonotonic",
            ],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        for block in out.strip().split("\n\n"):
            kv = {}
            for ln in block.splitlines():
                if "=" in ln:
                    k, v = ln.split("=", 1)
                    kv[k] = v
            uid = kv.get("Id", "").removesuffix(".service")
            if uid in props_by_id:
                props_by_id[uid] = kv
    except Exception:
        pass

    result = []
    for sid, name, desc in MANAGED_SERVICES:
        kv = props_by_id.get(sid, {})
        astate = kv.get("ActiveState", "inactive")
        status = "running" if astate in ("active", "reloading") else "stopped"
        try:
            mem_val = int(kv.get("MemoryCurrent", "0"))
        except ValueError:
            mem_val = 0
        try:
            mono_val = int(kv.get("ActiveEnterTimestampMonotonic", "0"))
        except ValueError:
            mono_val = 0
        result.append(
            {
                "id": sid,
                "name": name,
                "desc": desc,
                "status": status,
                "mem": fmt_mem(mem_val) if status == "running" else "—",
                "uptime": fmt_mono_uptime(mono_val) if status == "running" else "—",
            }
        )
    return result


def collect_listening_ports(panel_port: int = 8443) -> list[dict]:
    role_map = {
        22: "OpenSSH Direct",
        80: "HTTP · ACME · WS /alyan",
        109: "Dropbear + WS Target",
        143: "Dropbear Direct Tunnel",
        443: "TLS Multiplexer (SSH/WS/Xray)",
        panel_port: "Alyan Webpanel HTTPS",
        2095: "Alyan WS-Proxy (/alyan)",
        4443: "HAProxy TLS Offload",
        7700: "FastAPI Uvicorn Core",
        8880: "Nginx WS & XHTTP Router",
        8881: "Nginx gRPC h2c Router",
        10001: "Xray VLESS WS",
        10002: "Xray VMess WS",
        10003: "Xray Trojan WS",
        10011: "Xray VLESS gRPC",
        10012: "Xray VMess gRPC",
        10013: "Xray Trojan gRPC",
        10023: "Xray Trojan TCP",
        10031: "Xray VLESS XHTTP",
        10085: "Xray Stats API",
    }
    seen: dict[tuple[int, str], dict] = {}
    try:
        out = subprocess.check_output(["ss", "-tlnp"], text=True, stderr=subprocess.DEVNULL, timeout=4)
        for ln in out.splitlines()[1:]:
            cols = ln.split()
            if len(cols) < 4:
                continue
            local_ep = cols[3]
            if ":" not in local_ep:
                continue
            host_part, port_str = local_ep.rsplit(":", 1)
            if not port_str.isdigit():
                continue
            port = int(port_str)
            is_local = host_part.startswith("127.") or host_part in ("[::1]", "::1")
            scope = "local" if is_local else "public"
            addr = "127.0.0.1" if is_local else "0.0.0.0"
            m_proc = re.search(r'users:\(\("([^"]+)"', ln)
            proc = m_proc.group(1) if m_proc else "kernel"
            key = (port, scope)
            if key not in seen:
                seen[key] = {
                    "port": port,
                    "addr": addr,
                    "proc": proc,
                    "scope": scope,
                    "note": role_map.get(port, "System Listener"),
                }
    except Exception:
        pass
    return sorted(seen.values(), key=lambda x: (0 if x["scope"] == "public" else 1, x["port"]))


def build_overview_payload(conn: sqlite3.Connection, actor_info: dict) -> dict:
    iface = get_setting(conn, "iface", "eth0")
    snap = read_live_snapshot()
    inst = instant_host_metrics(iface)
    cfg = build_cfg_dict(conn)

    ssh_rows = [r for r in conn.execute("SELECT username, owner, status FROM ssh_users").fetchall() if can_access_owner(actor_info, r["owner"])]
    xray_rows = [r for r in conn.execute("SELECT uuid, proto, owner, status FROM xray_users").fetchall() if can_access_owner(actor_info, r["owner"])]

    ssh_live = snap.get("ssh_live", {})
    ssh_online = sum(
        int(ssh_live.get(r["username"], {}).get("online", 0))
        for r in ssh_rows
        if r["status"] == "active"
    )
    xray_live = snap.get("xray_live", {})
    xray_online = sum(
        int(xray_live.get(r["uuid"], {}).get("online", 0))
        for r in xray_rows
        if r["status"] == "active"
    )

    cpu_pct = int(snap.get("cpu_pct", inst["cpu_pct"]))
    ram_pct = int(snap.get("ram_pct", inst["ram_pct"]))
    hist = snap.get("hist") or {
        "cpu": [cpu_pct] * 12,
        "ram": [ram_pct] * 12,
        "rx": [0.4] * 12,
        "tx": [0.3] * 12,
    }

    snap_svcs = snap.get("services")
    snap_fresh = (time.time() - float(snap.get("ts", 0))) < 10.0
    svcs = snap_svcs if (isinstance(snap_svcs, list) and snap_svcs and snap_fresh) else collect_services()

    return {
        "cpu_pct": cpu_pct,
        "load": inst["load"],
        "ram_pct": ram_pct,
        "ram_used": inst["ram_used"],
        "ram_total": inst["ram_total"],
        "disk_pct": inst["disk_pct"],
        "disk_used": inst["disk_used"],
        "disk_total": inst["disk_total"],
        "rx_bps": float(snap.get("rx_bps", 0.0)),
        "tx_bps": float(snap.get("tx_bps", 0.0)),
        "rx_total": int(snap.get("rx_total", inst["rx_total"])),
        "tx_total": int(snap.get("tx_total", inst["tx_total"])),
        "ssh_total": len(ssh_rows),
        "ssh_online": ssh_online,
        "xray_total": len(xray_rows),
        "xray_online": xray_online,
        "xray_vless": sum(1 for r in xray_rows if r["proto"] == "vless"),
        "xray_vmess": sum(1 for r in xray_rows if r["proto"] == "vmess"),
        "xray_trojan": sum(1 for r in xray_rows if r["proto"] == "trojan"),
        "services": svcs,
        "cfg": cfg,
        "hist": hist,
    }


# ─── Daemon Control & Systemd Logs ───────────────────────────────────────────
def service_action(conn: sqlite3.Connection, actor_info: dict, svc_id: str, action: str, ip: str = "local") -> dict:
    if actor_info.get("role") == "viewer" and action != "logs":
        raise PermissionError("Viewer role cannot start/stop daemons")

    valid_ids = {s[0] for s in MANAGED_SERVICES}
    if svc_id != "all" and svc_id not in valid_ids:
        raise ValueError(f"Unknown service: {svc_id}")
    if action not in ("start", "stop", "restart", "logs"):
        raise ValueError(f"Unsupported action: {action}")

    if action == "logs":
        target = "haproxy" if svc_id == "all" else svc_id
        try:
            out = subprocess.check_output(
                ["journalctl", "-u", f"{target}.service", "-n", "80", "--no-pager", "-o", "short-iso"],
                text=True,
                stderr=subprocess.STDOUT,
                timeout=5,
            )
        except Exception as exc:
            out = f"Unable to read systemd journal for {target}: {exc}"
        return {"logs": out.strip() or f"No journal entries recorded yet for {target}.service"}

    if actor_info.get("role") != "super":
        raise PermissionError("Only Super Admins may control core daemons")

    if svc_id == "all":
        bot_cfg = json.loads(get_setting(conn, "bot_json", "{}"))
        stack = ["dropbear", "alyan-wsd", "xray", "nginx", "haproxy", "alyan-guard"]
        if bot_cfg.get("enabled"):
            stack.append("alyan-bot")
        for s in stack:
            subprocess.run(["systemctl", "restart", s], stderr=subprocess.DEVNULL)
        add_audit(conn, actor_info["username"], "svc_restart_all", "Full tunneling stack restarted", ip)
        conn.commit()
        return {"ok": True, "services": collect_services()}

    if svc_id == "alyan-panel" and action in ("restart", "stop"):
        add_audit(conn, actor_info["username"], f"svc_{action}", svc_id, ip)
        conn.commit()
        subprocess.Popen(
            ["bash", "-c", f"sleep 0.6 && systemctl {action} alyan-panel"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return {"ok": True, "services": collect_services()}

    subprocess.run(["systemctl", action, svc_id], stderr=subprocess.DEVNULL)
    add_audit(conn, actor_info["username"], f"svc_{action}", svc_id, ip)
    conn.commit()
    return {"ok": True, "services": collect_services()}


# ─── SSH Tunnel Account Management ───────────────────────────────────────────
def kill_ssh_user_sessions(username: str):
    """Terminate both OpenSSH user-owned processes and root-owned Dropbear worker children."""
    subprocess.run(["pkill", "-KILL", "-u", username], stderr=subprocess.DEVNULL)
    try:
        out = subprocess.check_output(
            ["journalctl", "-u", "dropbear", "-n", "400", "--no-pager", "-o", "short-iso"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
        pat = re.compile(
            r"(?:dropbear\[(\d+)\]|\[(\d+)\]).*?(?:Password|Pubkey) auth succeeded for '([^']+)'",
            re.IGNORECASE,
        )
        target_low = username.lower()
        for ln in out.splitlines():
            m = pat.search(ln)
            if not m or m.group(3).lower() != target_low:
                continue
            pid = int(m.group(1) or m.group(2))
            comm_p = Path(f"/proc/{pid}/comm")
            stat_p = Path(f"/proc/{pid}/status")
            if not comm_p.exists() or "dropbear" not in comm_p.read_text(errors="ignore").lower():
                continue
            ppid = 1
            for sln in stat_p.read_text(errors="ignore").splitlines():
                if sln.startswith("PPid:"):
                    ppid = int(sln.split(":", 1)[1].strip())
                    break
            if ppid > 1:
                try:
                    os.kill(pid, 9)
                except OSError:
                    pass
    except Exception:
        pass


def validate_username(username: str) -> str:
    u = (username or "").strip()
    if not SAFE_USER_RE.match(u):
        raise ValueError("Invalid username (use 1-31 letters, digits, _ or -)")
    if u.lower() in RESERVED_USERS:
        raise ValueError(f"Username '{u}' is reserved by the operating system")
    return u


def format_ssh_row(row: sqlite3.Row, ssh_live: dict, is_viewer: bool = False) -> dict:
    uname = row["username"]
    is_dis = row["status"] == "disabled"
    live = ssh_live.get(uname, {})
    return {
        "username": uname,
        "password": "••••" if is_viewer else row["password"],
        "used_bytes": int(row["used_bytes"]),
        "gb_limit": float(row["gb_limit"]),
        "ip_limit": 0 if is_viewer else int(row["ip_limit"]),
        "online": 0 if (is_dis or is_viewer) else int(live.get("online", 0)),
        "ips": [] if (is_dis or is_viewer) else list(live.get("ips", [])),
        "expiry": row["expiry"],
        "status": row["status"],
        "owner": row["owner"],
    }


def ssh_list(conn: sqlite3.Connection, actor_info: dict) -> dict:
    snap = read_live_snapshot()
    ssh_live = snap.get("ssh_live", {})
    is_viewer = actor_info.get("role") == "viewer"
    rows = conn.execute("SELECT * FROM ssh_users ORDER BY rowid DESC").fetchall()
    items = [format_ssh_row(r, ssh_live, is_viewer) for r in rows if can_access_owner(actor_info, r["owner"])]
    return {"items": items, "cfg": build_cfg_dict(conn)}


def ssh_add(
    conn: sqlite3.Connection,
    actor_info: dict,
    username: str,
    password: str,
    days: int = 30,
    gb_limit: float = 0.0,
    ip_limit: int = 2,
    ip: str = "local",
) -> dict:
    check_write_permission(conn, actor_info, creating=True)
    u = validate_username(username)
    pw = (password or "").strip()
    if not pw:
        raise ValueError("Password is required")

    dup = conn.execute("SELECT 1 FROM ssh_users WHERE LOWER(username) = LOWER(?)", (u,)).fetchone()
    if dup:
        raise ValueError(f"SSH account '{u}' already exists")

    shells_file = Path("/etc/shells")
    if shells_file.exists() and "/bin/false" not in shells_file.read_text(encoding="utf-8", errors="ignore"):
        with shells_file.open("a", encoding="utf-8") as sf:
            sf.write("\n/bin/false\n")

    exp_date = (dt.date.today() + dt.timedelta(days=max(1, int(days)))).isoformat()
    if subprocess.run(["id", "-u", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["usermod", "-s", "/bin/false", "-e", exp_date, u], check=True, stderr=subprocess.PIPE)
    else:
        subprocess.run(["useradd", "-M", "-N", "-s", "/bin/false", "-e", exp_date, u], check=True, stderr=subprocess.PIPE)
    subprocess.run(["chpasswd"], input=f"{u}:{pw}\n", text=True, check=True, stderr=subprocess.PIPE)
    subprocess.run(["usermod", "-U", u], stderr=subprocess.DEVNULL)

    today = dt.date.today().isoformat()
    owner = actor_info["username"]
    conn.execute(
        """
        INSERT INTO ssh_users (username, password, used_bytes, gb_limit, ip_limit, expiry, status, owner, created)
        VALUES (?, ?, 0, ?, ?, ?, 'active', ?, ?)
        """,
        (u, pw, max(0.0, float(gb_limit)), max(0, int(ip_limit)), exp_date, owner, today),
    )
    add_audit(conn, owner, "ssh_create", f"user={u} days={days} gb={gb_limit} ip={ip_limit}", ip)
    conn.commit()

    row = conn.execute("SELECT * FROM ssh_users WHERE username = ?", (u,)).fetchone()
    return {"item": format_ssh_row(row, {}), "cfg": build_cfg_dict(conn)}


def ssh_edit(conn: sqlite3.Connection, actor_info: dict, username: str, payload: dict, ip: str = "local") -> dict:
    check_write_permission(conn, actor_info, creating=False)
    row = conn.execute("SELECT * FROM ssh_users WHERE username = ?", (username,)).fetchone()
    if not row:
        raise ValueError(f"SSH account '{username}' not found")
    if not can_access_owner(actor_info, row["owner"]):
        raise PermissionError("Access denied to this SSH account")

    pw = str(payload.get("password") or "").strip() or row["password"]
    if payload.get("password") and str(payload["password"]).strip():
        subprocess.run(["chpasswd"], input=f"{username}:{pw}\n", text=True, stderr=subprocess.DEVNULL)

    expiry = row["expiry"]
    if payload.get("days") not in (None, ""):
        days_val = max(1, int(float(payload["days"])))
        expiry = (dt.date.today() + dt.timedelta(days=days_val)).isoformat()
        subprocess.run(["chage", "-E", expiry, username], stderr=subprocess.DEVNULL)

    gb_lim = float(payload["gb_limit"]) if payload.get("gb_limit") not in (None, "") else float(row["gb_limit"])
    ip_lim = int(float(payload["ip_limit"])) if payload.get("ip_limit") not in (None, "") else int(row["ip_limit"])
    used_b = 0 if payload.get("reset_quota") else int(row["used_bytes"])

    status = row["status"]
    if payload.get("status") in ("active", "disabled"):
        status = payload["status"]
        if status == "disabled":
            subprocess.run(["usermod", "-L", username], stderr=subprocess.DEVNULL)
            kill_ssh_user_sessions(username)
        else:
            subprocess.run(["usermod", "-U", username], stderr=subprocess.DEVNULL)
            subprocess.run(["chage", "-E", expiry, username], stderr=subprocess.DEVNULL)

    conn.execute(
        """
        UPDATE ssh_users
           SET password = ?, used_bytes = ?, gb_limit = ?, ip_limit = ?, expiry = ?, status = ?
         WHERE username = ?
        """,
        (pw, used_b, max(0.0, gb_lim), max(0, ip_lim), expiry, status, username),
    )
    act_tag = f"ssh_{status}" if payload.get("status") else "ssh_edit"
    add_audit(conn, actor_info["username"], act_tag, f"user={username}", ip)
    conn.commit()

    snap = read_live_snapshot()
    updated = conn.execute("SELECT * FROM ssh_users WHERE username = ?", (username,)).fetchone()
    return {"item": format_ssh_row(updated, snap.get("ssh_live", {}))}


def ssh_del(conn: sqlite3.Connection, actor_info: dict, username: str, ip: str = "local") -> dict:
    check_write_permission(conn, actor_info, creating=False)
    row = conn.execute("SELECT * FROM ssh_users WHERE username = ?", (username,)).fetchone()
    if not row:
        raise ValueError(f"SSH account '{username}' not found")
    if not can_access_owner(actor_info, row["owner"]):
        raise PermissionError("Access denied to this SSH account")

    kill_ssh_user_sessions(username)
    subprocess.run(["userdel", "-f", username], stderr=subprocess.DEVNULL)
    conn.execute("DELETE FROM ssh_users WHERE username = ?", (username,))
    add_audit(conn, actor_info["username"], "ssh_delete", f"user={username}", ip)
    conn.commit()
    return {"ok": True}


