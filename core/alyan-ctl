    sub.add_parser("audit-list")

    args = parser.parse_args()

    if args.cmd == "get-initial-pass":
        if CREDS_FILE.exists():
            print(CREDS_FILE.read_text(encoding="utf-8").strip())
        else:
            print("See Webpanel Settings")
        return

    if args.cmd == "get-super-admin":
        conn = get_db()
        row = conn.execute("SELECT username FROM admins WHERE role = 'super' ORDER BY rowid ASC LIMIT 1").fetchone()
        print(row["username"] if row else "admin")
        return

    conn = get_db()
    try:
        actor_info = resolve_actor(conn, args.actor)
        cip = args.client_ip

        if args.cmd == "init":
            out = init_system(conn, args.domain, args.panel_port, args.iface, args.ip)
        elif args.cmd == "ssl-issue":
            out = issue_ssl(conn, standalone=args.standalone)
        elif args.cmd in ("overview", "telemetry"):
            out = build_overview_payload(conn, actor_info)
        elif args.cmd == "engine":
            prt = int(get_setting(conn, "panel_port", "8443"))
            is_viewer = actor_info.get("role") == "viewer"
            out = {"services": collect_services(), "ports": [] if is_viewer else collect_listening_ports(prt)}
        elif args.cmd == "xray-sync":
            sync_xray_config(conn, reload_service=True)
            out = {"ok": True}
        elif args.cmd == "tg-test":
            out = send_telegram_test(conn)
        elif args.cmd == "bot-config":
            out = {"cfg": build_cfg_dict(conn)}
        elif args.cmd == "service":
            out = service_action(conn, actor_info, args.svc_id, args.action, ip=cip)
        elif args.cmd == "ssh-list":
            out = ssh_list(conn, actor_info)
        elif args.cmd == "ssh-add":
            out = ssh_add(conn, actor_info, args.username, args.password, args.days, args.gb_limit, args.ip_limit, ip=cip)
        elif args.cmd == "ssh-edit":
            out = ssh_edit(conn, actor_info, args.username, json.loads(args.json), ip=cip)
        elif args.cmd == "ssh-del":
            out = ssh_del(conn, actor_info, args.username, ip=cip)
        elif args.cmd == "xray-list":
            out = xray_list(conn, actor_info)
        elif args.cmd == "xray-add":
            out = xray_add(conn, actor_info, args.username, args.proto, args.days, args.gb_limit, args.ip_limit, args.uuid, ip=cip)
        elif args.cmd == "xray-edit":
            out = xray_edit(conn, actor_info, args.uuid, json.loads(args.json), ip=cip)
        elif args.cmd == "xray-del":
            out = xray_del(conn, actor_info, args.uuid, ip=cip)
        elif args.cmd == "settings":
            out = apply_settings(conn, actor_info, json.loads(args.json), ip=cip)
        elif args.cmd == "admin-login":
            out = admin_login(conn, args.username, args.password, ip=cip)
        elif args.cmd == "admin-me":
            out = admin_me(conn, args.username)
        elif args.cmd == "admin-list":
            out = admin_list(conn, actor_info)
        elif args.cmd == "admin-add":
            out = admin_add(conn, actor_info, json.loads(args.json), ip=cip)
        elif args.cmd == "admin-del":
            out = admin_del(conn, actor_info, args.username, ip=cip)
        elif args.cmd == "audit-list":
            out = audit_list(conn, actor_info)
        else:
            raise ValueError(f"Unhandled subcommand: {args.cmd}")

        print(json.dumps(out))
    except PermissionError as exc:
        print(json.dumps({"error": str(exc), "code": 403}))
        sys.exit(1)
    except ValueError as exc:
        print(json.dumps({"error": str(exc), "code": 400}))
        sys.exit(1)
    except Exception as exc:
        print(json.dumps({"error": str(exc), "code": 500}))
        sys.exit(1)
    finally:
        conn.close()


