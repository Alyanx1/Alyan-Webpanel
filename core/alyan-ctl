def validate_username(username: str) -> str:
    u = (username or "").strip()
    if not SAFE_USER_RE.match(u):
        raise ValueError("Invalid username (use 1-31 letters, digits, _ or -)")
    if u.lower() in RESERVED_USERS:
        raise ValueError(f"Username '{u}' is reserved by the operating system")
    return u


def format_ssh_row(row: sqlite3.Row, ssh_live: dict) -> dict:
    uname = row["username"]
    is_dis = row["status"] == "disabled"
    live = ssh_live.get(uname, {})
    return {
        "username": uname,
        "password": row["password"],
        "used_bytes": int(row["used_bytes"]),
        "gb_limit": float(row["gb_limit"]),
        "ip_limit": int(row["ip_limit"]),
        "online": 0 if is_dis else int(live.get("online", 0)),
        "ips": [] if is_dis else list(live.get("ips", [])),
        "expiry": row["expiry"],
        "status": row["status"],
        "owner": row["owner"],
    }


