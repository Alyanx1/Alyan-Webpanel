# ─── Password Hashing (Pure Stdlib PBKDF2-SHA256) ────────────────────────────
def hash_password(password: str) -> str:
    salt = secrets.token_hex(16)
    dk = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("utf-8"), 260000)
    return f"pbkdf2_sha256$260000${salt}${dk.hex()}"


def verify_password(password: str, stored: str) -> bool:
    try:
        algo, iters, salt, digest = stored.split("$", 3)
        if algo != "pbkdf2_sha256":
            return False
        dk = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt.encode("utf-8"), int(iters))
        return hmac.compare_digest(dk.hex(), digest)
    except Exception:
        return False


# ─── SQLite Connection & Schema ──────────────────────────────────────────────
def get_db() -> sqlite3.Connection:
    VAR_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH), timeout=15.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA foreign_keys=ON;")
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS settings (
            key   TEXT PRIMARY KEY,
            value TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS admins (
            username     TEXT PRIMARY KEY,
            pass_hash    TEXT NOT NULL,
            role         TEXT NOT NULL DEFAULT 'admin',
            max_accounts INTEGER NOT NULL DEFAULT 0,
            scope        TEXT NOT NULL DEFAULT 'own',
            status       TEXT NOT NULL DEFAULT 'active',
            last_login   TEXT NOT NULL DEFAULT 'Never',
            created      TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS ssh_users (
            username   TEXT PRIMARY KEY,
            password   TEXT NOT NULL,
            used_bytes INTEGER NOT NULL DEFAULT 0,
            gb_limit   REAL NOT NULL DEFAULT 0,
            ip_limit   INTEGER NOT NULL DEFAULT 0,
            expiry     TEXT NOT NULL,
            status     TEXT NOT NULL DEFAULT 'active',
            owner      TEXT NOT NULL DEFAULT 'admin',
            created    TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS xray_users (
            uuid       TEXT PRIMARY KEY,
            username   TEXT NOT NULL,
            proto      TEXT NOT NULL,
            used_bytes INTEGER NOT NULL DEFAULT 0,
            gb_limit   REAL NOT NULL DEFAULT 0,
            ip_limit   INTEGER NOT NULL DEFAULT 0,
            expiry     TEXT NOT NULL,
            status     TEXT NOT NULL DEFAULT 'active',
            owner      TEXT NOT NULL DEFAULT 'admin',
            created    TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS audit_log (
            id         INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at TEXT NOT NULL,
            actor      TEXT NOT NULL,
            action     TEXT NOT NULL,
            detail     TEXT NOT NULL,
            ip         TEXT NOT NULL DEFAULT 'local'
        );
        """
    )
    return conn


def get_setting(conn: sqlite3.Connection, key: str, default: str = "") -> str:
    row = conn.execute("SELECT value FROM settings WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else default


def set_setting(conn: sqlite3.Connection, key: str, value: str):
    conn.execute(
        "INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (key, str(value)),
    )


def add_audit(conn: sqlite3.Connection, actor: str, action: str, detail: str, ip: str = "local"):
    conn.execute(
        "INSERT INTO audit_log (created_at, actor, action, detail, ip) VALUES (?, ?, ?, ?, ?)",
        (dt.datetime.now().strftime("%H:%M:%S"), actor, action, detail, ip),
    )


# ─── System Metadata & SSL Helpers ───────────────────────────────────────────
def ssl_days_remaining() -> int:
    cert = SSL_DIR / "fullchain.pem"
    if not cert.exists():
        return 0
    try:
        out = subprocess.check_output(
            ["openssl", "x509", "-enddate", "-noout", "-in", str(cert)],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        # notAfter=Jan 28 06:00:00 2027 GMT
        dt_str = out.split("=", 1)[1].strip()
        exp = dt.datetime.strptime(dt_str, "%b %d %H:%M:%S %Y %Z")
        return max(0, (exp - dt.datetime.utcnow()).days)
    except Exception:
        return 89


def system_uptime_human() -> str:
    try:
        secs = int(float(Path("/proc/uptime").read_text().split()[0]))
        d, rem = divmod(secs, 86400)
        h, rem = divmod(rem, 3600)
        m, _ = divmod(rem, 60)
        return f"{d}d {h}h {m}m" if d else f"{h}h {m}m"
    except Exception:
        return "0h 1m"


def detect_os_and_cpu() -> tuple[str, str, str]:
    os_name = "Ubuntu Linux"
    try:
        for ln in Path("/etc/os-release").read_text().splitlines():
            if ln.startswith("PRETTY_NAME="):
                os_name = ln.split("=", 1)[1].strip().strip('"')
                break
    except Exception:
        pass
    kernel = f"{os.uname().release} ({os.uname().machine})"
    cpu_model = "vCPU"
    cores = os.cpu_count() or 1
    try:
        for ln in Path("/proc/cpuinfo").read_text().splitlines():
            if "model name" in ln or "Model" in ln:
                cpu_model = ln.split(":", 1)[1].strip()
                break
    except Exception:
        pass
    return os_name, kernel, f"{cpu_model} · {cores} vCPU"


def build_cfg_dict(conn: sqlite3.Connection) -> dict:
    os_name, kernel, cpu_model = detect_os_and_cpu()
    qos = json.loads(get_setting(conn, "qos_json", '{"enabled":true,"iface":"eth0","bw_mbps":500,"preset":"gaming","caps":[]}'))
    bot = json.loads(get_setting(conn, "bot_json", '{"enabled":false,"token":"","admin_id":"","alerts":true}'))
    return {
        "domain": get_setting(conn, "domain", "localhost"),
        "panel_port": int(get_setting(conn, "panel_port", "8443")),
        "ssl_days": ssl_days_remaining(),
        "ip": get_setting(conn, "ip", "127.0.0.1"),
        "location": get_setting(conn, "location", "Cloud Edge"),
        "provider": get_setting(conn, "provider", "Dedicated VPS"),
        "os": os_name,
        "kernel": kernel,
        "cpu_model": cpu_model,
        "uptime": system_uptime_human(),
        "ws_path": "/alyan",
        "banner": get_setting(conn, "banner", ""),
        "qos": qos,
        "bot": bot,
    }


# ─── Config Rendering & Stack Sync ───────────────────────────────────────────
def configure_dropbear_and_banner(banner_text: str):
    ETC_DIR.mkdir(parents=True, exist_ok=True)
    BANNER_FILE.write_text(banner_text or "", encoding="utf-8")

    # Configure /etc/default/dropbear + systemd override for Ubuntu 22.04 & 24.04 compatibility
    Path("/etc/default/dropbear").write_text(
        'NO_START=0\nDROPBEAR_PORT=109\nDROPBEAR_EXTRA_ARGS="-p 143 -b /etc/alyan/banner.txt -w -K 60 -I 300"\nDROPBEAR_BANNER="/etc/alyan/banner.txt"\n',
        encoding="utf-8",
    )
    ovr_dir = Path("/etc/systemd/system/dropbear.service.d")
    ovr_dir.mkdir(parents=True, exist_ok=True)
    db_bin = shutil.which("dropbear") or "/usr/sbin/dropbear"
    (ovr_dir / "alyan.conf").write_text(
        f"[Service]\nExecStart=\nExecStart={db_bin} -EF -p 109 -p 143 -b /etc/alyan/banner.txt -w -K 60 -I 300\n",
        encoding="utf-8",
    )

    sshd_cfg = Path("/etc/ssh/sshd_config")
    if sshd_cfg.exists():
        txt = sshd_cfg.read_text(encoding="utf-8", errors="ignore")
        if "Banner /etc/alyan/banner.txt" not in txt:
            txt = re.sub(r"^#?\s*Banner\s+.*$", "", txt, flags=re.MULTILINE)
            txt = txt.rstrip() + "\nBanner /etc/alyan/banner.txt\n"
            sshd_cfg.write_text(txt, encoding="utf-8")
            subprocess.run(["systemctl", "reload", "ssh"], stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "reload", "sshd"], stderr=subprocess.DEVNULL)


def sync_xray_config(conn: sqlite3.Connection, reload_service: bool = True):
    tpl_path = TPL_DIR / "xray-config.json.tpl"
    if not tpl_path.exists():
        return
    rows = conn.execute("SELECT * FROM xray_users WHERE status = 'active'").fetchall()
    vless_c, vmess_c, trojan_c = [], [], []
    for r in rows:
        email = f"{r['username']}@alyan"
        if r["proto"] == "vless":
            vless_c.append({"id": r["uuid"], "email": email, "level": 0})
        elif r["proto"] == "vmess":
            vmess_c.append({"id": r["uuid"], "alterId": 0, "email": email, "level": 0})
        elif r["proto"] == "trojan":
            trojan_c.append({"password": r["uuid"], "email": email, "level": 0})

    rendered = (
        tpl_path.read_text(encoding="utf-8")
        .replace("{{VLESS_CLIENTS}}", json.dumps(vless_c))
        .replace("{{VMESS_CLIENTS}}", json.dumps(vmess_c))
        .replace("{{TROJAN_CLIENTS}}", json.dumps(trojan_c))
    )
    out_dir = Path("/usr/local/etc/xray")
    out_dir.mkdir(parents=True, exist_ok=True)
    Path("/var/log/xray").mkdir(parents=True, exist_ok=True)
    (out_dir / "config.json").write_text(rendered, encoding="utf-8")
    if reload_service:
        subprocess.run(["systemctl", "restart", "xray"], stderr=subprocess.DEVNULL)


def render_all_configs(conn: sqlite3.Connection, reload_daemons: bool = False):
    domain = get_setting(conn, "domain", "localhost")
