    rows = conn.execute("SELECT * FROM xray_users ORDER BY rowid DESC").fetchall()
    items = [format_xray_row(r, xray_live, is_viewer) for r in rows if can_access_owner(actor_info, r["owner"])]
    return {"items": items, "cfg": build_cfg_dict(conn)}


def xray_add(
    conn: sqlite3.Connection,
    actor_info: dict,
    username: str,
    proto: str = "vless",
    days: int = 30,
    gb_limit: float = 0.0,
    ip_limit: int = 2,
    custom_uuid: str = "",
    ip: str = "local",
) -> dict:
    check_write_permission(conn, actor_info, creating=True)
    u = validate_username(username)
    p = (proto or "vless").lower().strip()
    if p not in ("vless", "vmess", "trojan"):
        raise ValueError("Protocol must be vless, vmess, or trojan")

    uid = (custom_uuid or "").strip() or str(uuid_mod.uuid4())
    if conn.execute("SELECT 1 FROM xray_users WHERE uuid = ?", (uid,)).fetchone():
        raise ValueError("UUID / key already exists")
    if conn.execute("SELECT 1 FROM xray_users WHERE LOWER(username) = LOWER(?) AND proto = ?", (u, p)).fetchone():
        raise ValueError(f"{p.upper()} client '{u}' already exists")

    exp_date = (dt.date.today() + dt.timedelta(days=max(1, int(days)))).isoformat()
    today = dt.date.today().isoformat()
    owner = actor_info["username"]
    conn.execute(
        """
        INSERT INTO xray_users (uuid, username, proto, used_bytes, gb_limit, ip_limit, expiry, status, owner, created)
        VALUES (?, ?, ?, 0, ?, ?, ?, 'active', ?, ?)
        """,
        (uid, u, p, max(0.0, float(gb_limit)), max(0, int(ip_limit)), exp_date, owner, today),
    )
    add_audit(conn, owner, "xray_create", f"proto={p} user={u}", ip)
    conn.commit()
    sync_xray_config(conn, reload_service=True)

    row = conn.execute("SELECT * FROM xray_users WHERE uuid = ?", (uid,)).fetchone()
    return {"item": format_xray_row(row, {}), "cfg": build_cfg_dict(conn)}


def xray_edit(conn: sqlite3.Connection, actor_info: dict, uuid_key: str, payload: dict, ip: str = "local") -> dict:
    check_write_permission(conn, actor_info, creating=False)
    row = conn.execute("SELECT * FROM xray_users WHERE uuid = ?", (uuid_key,)).fetchone()
    if not row:
        raise ValueError("Xray client not found")
    if not can_access_owner(actor_info, row["owner"]):
        raise PermissionError("Access denied to this Xray client")

    new_u = validate_username(payload["username"]) if payload.get("username") else row["username"]
    new_p = str(payload.get("proto") or row["proto"]).lower().strip()
    if new_p not in ("vless", "vmess", "trojan"):
        raise ValueError("Protocol must be vless, vmess, or trojan")

    new_uid = str(payload.get("new_uuid") or uuid_key).strip() or uuid_key
    if new_uid != uuid_key:
        if conn.execute("SELECT 1 FROM xray_users WHERE uuid = ?", (new_uid,)).fetchone():
            raise ValueError("Target UUID / key is already in use")

    expiry = row["expiry"]
    if payload.get("days") not in (None, ""):
        expiry = (dt.date.today() + dt.timedelta(days=max(1, int(float(payload["days"]))))).isoformat()

    gb_lim = float(payload["gb_limit"]) if payload.get("gb_limit") not in (None, "") else float(row["gb_limit"])
    ip_lim = int(float(payload["ip_limit"])) if payload.get("ip_limit") not in (None, "") else int(row["ip_limit"])
    used_b = 0 if payload.get("reset_quota") else int(row["used_bytes"])
    status = payload["status"] if payload.get("status") in ("active", "disabled") else row["status"]

    conn.execute(
        """
        UPDATE xray_users
           SET uuid = ?, username = ?, proto = ?, used_bytes = ?, gb_limit = ?, ip_limit = ?, expiry = ?, status = ?
         WHERE uuid = ?
        """,
        (new_uid, new_u, new_p, used_b, max(0.0, gb_lim), max(0, ip_lim), expiry, status, uuid_key),
    )
    act_tag = f"xray_{status}" if payload.get("status") else "xray_edit"
    add_audit(conn, actor_info["username"], act_tag, f"proto={new_p} user={new_u}", ip)
    conn.commit()
    sync_xray_config(conn, reload_service=True)

    snap = read_live_snapshot()
    updated = conn.execute("SELECT * FROM xray_users WHERE uuid = ?", (new_uid,)).fetchone()
    return {"item": format_xray_row(updated, snap.get("xray_live", {})), "cfg": build_cfg_dict(conn)}


def xray_del(conn: sqlite3.Connection, actor_info: dict, uuid_key: str, ip: str = "local") -> dict:
    check_write_permission(conn, actor_info, creating=False)
    row = conn.execute("SELECT * FROM xray_users WHERE uuid = ?", (uuid_key,)).fetchone()
    if not row:
        raise ValueError("Xray client not found")
    if not can_access_owner(actor_info, row["owner"]):
