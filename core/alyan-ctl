def admin_login(conn: sqlite3.Connection, username: str, password: str, ip: str = "local") -> dict:
    u = (username or "").strip()
    row = conn.execute("SELECT * FROM admins WHERE LOWER(username) = LOWER(?)", (u,)).fetchone()
    if not row or row["status"] != "active" or not verify_password(password or "", row["pass_hash"]):
        raise PermissionError("Invalid username or password")

    now_str = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
    conn.execute("UPDATE admins SET last_login = ? WHERE username = ?", (now_str, row["username"]))
    add_audit(conn, row["username"], "login", "Webpanel session authenticated", ip)
    conn.commit()
    return {
        "user": {
            "username": row["username"],
            "role": row["role"],
            "scope": row["scope"],
            "max_accounts": int(row["max_accounts"]),
        },
        "cfg": build_cfg_dict(conn),
    }


def admin_me(conn: sqlite3.Connection, username: str) -> dict:
    row = conn.execute("SELECT * FROM admins WHERE username = ? AND status = 'active'", (username,)).fetchone()
    if not row:
        raise PermissionError("Session expired or admin removed")
    return {
        "user": {
            "username": row["username"],
            "role": row["role"],
            "scope": row["scope"],
            "max_accounts": int(row["max_accounts"]),
        },
        "cfg": build_cfg_dict(conn),
    }


def admin_list(conn: sqlite3.Connection, actor_info: dict) -> dict:
    rows = conn.execute("SELECT * FROM admins ORDER BY rowid ASC").fetchall()
    items = []
    role = actor_info.get("role")
    for r in rows:
        if role not in ("super", "viewer") and r["username"] != actor_info.get("username"):
            continue
        uname = r["username"]
        c_ssh = conn.execute("SELECT COUNT(*) AS c FROM ssh_users WHERE owner = ?", (uname,)).fetchone()["c"]
        c_xry = conn.execute("SELECT COUNT(*) AS c FROM xray_users WHERE owner = ?", (uname,)).fetchone()["c"]
        items.append(
            {
                "username": uname,
                "role": r["role"],
                "max_accounts": int(r["max_accounts"]),
                "scope": r["scope"],
                "accounts": int(c_ssh + c_xry),
                "status": r["status"],
                "last_login": r["last_login"],
                "created": r["created"],
            }
        )
    return {"items": items}


def admin_add(conn: sqlite3.Connection, actor_info: dict, payload: dict, ip: str = "local") -> dict:
    if actor_info.get("role") != "super":
        raise PermissionError("Only Super Admins may create panel admins")
    u = validate_username(payload.get("username", ""))
    pw = str(payload.get("password") or "")
    if len(pw) < 6:
        raise ValueError("Password must be at least 6 characters")
    role = str(payload.get("role") or "admin").lower()
    if role not in ("super", "admin", "viewer"):
        raise ValueError("Invalid role")
    scope = str(payload.get("scope") or ("all" if role in ("super", "viewer") else "own")).lower()
    if role == "viewer":
        scope = "all"
    if scope not in ("own", "all"):
        scope = "own"
    max_acc = 0 if role == "super" else max(0, int(float(payload.get("max_accounts") or 0)))

    if conn.execute("SELECT 1 FROM admins WHERE LOWER(username) = LOWER(?)", (u,)).fetchone():
        raise ValueError(f"Admin '{u}' already exists")

    conn.execute(
        """
        INSERT INTO admins (username, pass_hash, role, max_accounts, scope, status, last_login, created)
        VALUES (?, ?, ?, ?, ?, 'active', 'Never', ?)
        """,
        (u, hash_password(pw), role, max_acc, scope, dt.date.today().isoformat()),
    )
    add_audit(conn, actor_info["username"], "admin_create", f"user={u} role={role}", ip)
    conn.commit()
    return {"ok": True}


def admin_del(conn: sqlite3.Connection, actor_info: dict, target_user: str, ip: str = "local") -> dict:
    if actor_info.get("role") != "super":
        raise PermissionError("Only Super Admins may revoke panel admins")
    target_row = conn.execute("SELECT * FROM admins WHERE username = ?", (target_user,)).fetchone()
    if not target_row:
        raise ValueError("Admin not found")
    if target_row["role"] == "super":
        super_count = conn.execute("SELECT COUNT(*) AS c FROM admins WHERE role = 'super'").fetchone()["c"]
        if super_count <= 1:
            raise ValueError("Primary Super Admin cannot be removed")
    if target_user == actor_info.get("username"):
        raise ValueError("Cannot delete your own active session")
    conn.execute("DELETE FROM admins WHERE username = ?", (target_user,))
    add_audit(conn, actor_info["username"], "admin_delete", f"user={target_user}", ip)
    conn.commit()
    return {"ok": True}


def audit_list(conn: sqlite3.Connection, actor_info: dict, limit: int = 120) -> dict:
    if actor_info.get("role") in ("super", "viewer") or actor_info.get("scope") == "all":
        rows = conn.execute("SELECT * FROM audit_log ORDER BY id DESC LIMIT ?", (limit,)).fetchall()
    else:
        rows = conn.execute(
            "SELECT * FROM audit_log WHERE actor = ? ORDER BY id DESC LIMIT ?",
            (actor_info["username"], limit),
        ).fetchall()
    items = [
        {
            "time": r["created_at"],
            "user": r["actor"],
            "action": r["action"],
            "detail": r["detail"],
            "ip": r["ip"],
        }
        for r in rows
    ]
    return {"items": items}


