RESERVED_INTERNAL_PORTS = {22, 80, 109, 143, 443, 2095, 4443, 7700, 8880, 8881, 10001, 10002, 10003, 10011, 10012, 10013, 10023, 10031, 10085}


def ensure_self_signed_ssl(domain: str):
    SSL_DIR.mkdir(parents=True, exist_ok=True)
    fc = SSL_DIR / "fullchain.pem"
    pk = SSL_DIR / "privkey.pem"
    hp = SSL_DIR / "haproxy.pem"
    if not fc.exists() or not pk.exists():
        subprocess.run(
            [
                "openssl", "req", "-x509", "-nodes", "-newkey", "ec",
                "-pkeyopt", "ec_paramgen_curve:prime256v1",
                "-days", "365", "-subj", f"/CN={domain}",
                "-keyout", str(pk), "-out", str(fc),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    if fc.exists() and pk.exists():
        hp.write_text(fc.read_text(encoding="utf-8") + "\n" + pk.read_text(encoding="utf-8"), encoding="utf-8")
        os.chmod(fc, 0o600)
        os.chmod(pk, 0o600)
        os.chmod(hp, 0o600)


def apply_settings(conn: sqlite3.Connection, actor_info: dict, payload: dict, ip: str = "local") -> dict:
    uname = actor_info["username"]
    is_super = actor_info.get("role") == "super"

    # Allow any non-viewer admin to update their own password
    if payload.get("new_password"):
        if actor_info.get("role") == "viewer":
            raise PermissionError("Viewer role cannot modify credentials")
        new_pw = str(payload["new_password"])
        if len(new_pw) < 6:
            raise ValueError("Password must be at least 6 characters")
        target_admin = str(payload.get("target_admin") or uname)
        if target_admin != uname and not is_super:
            raise PermissionError("Only Super Admins may reset other admin passwords")
        conn.execute("UPDATE admins SET pass_hash = ? WHERE username = ?", (hash_password(new_pw), target_admin))
        if target_admin == "admin" and CREDS_FILE.exists():
            CREDS_FILE.write_text(new_pw + "\n", encoding="utf-8")
            os.chmod(CREDS_FILE, 0o600)
        add_audit(conn, uname, "password_change", f"user={target_admin}", ip)

    # Global server mutations require Super Admin
    server_keys = {"domain", "panel_port", "ssl_renew", "banner", "qos", "add_cap", "del_cap", "bot", "maint"}
    if any(k in payload for k in server_keys) and not is_super:
        raise PermissionError("Only Super Admins may modify global server settings")

    need_render = False
    need_ssl = bool(payload.get("ssl_renew"))

    if payload.get("domain"):
        dom = str(payload["domain"]).strip().lower()
        if not SAFE_DOMAIN_RE.match(dom):
            raise ValueError("Invalid domain format (example: panel.example.com)")
        old_dom = get_setting(conn, "domain", "")
        set_setting(conn, "domain", dom)
        add_audit(conn, uname, "domain_set", dom, ip)
        need_render = True
        if dom != old_dom:
            need_ssl = True

    if payload.get("panel_port") is not None:
        prt = int(payload["panel_port"])
        if prt < 1024 or prt > 65535 or prt in RESERVED_INTERNAL_PORTS:
            raise ValueError("Choose an unreserved TCP port between 1024 and 65535")
        set_setting(conn, "panel_port", str(prt))
        add_audit(conn, uname, "port_set", f"port={prt}", ip)
        need_render = True

    if "banner" in payload and payload["banner"] is not None:
        btxt = str(payload["banner"])
        set_setting(conn, "banner", btxt)
        configure_dropbear_and_banner(btxt)
        subprocess.run(["systemctl", "restart", "dropbear"], stderr=subprocess.DEVNULL)
        add_audit(conn, uname, "banner_set", f"{len(btxt)} bytes", ip)

    if any(k in payload for k in ("qos", "add_cap", "del_cap")):
        qos = json.loads(get_setting(conn, "qos_json", '{"enabled":true,"iface":"eth0","bw_mbps":500,"preset":"gaming","caps":[]}'))
        if isinstance(payload.get("qos"), dict):
            qos.update(payload["qos"])
        if isinstance(payload.get("add_cap"), dict):
            cap_ip = str(payload["add_cap"].get("ip") or "").strip()
            cap_mb = max(1, int(float(payload["add_cap"].get("mbps") or 25)))
            if not re.match(r"^\d{1,3}(\.\d{1,3}){3}$", cap_ip):
                raise ValueError("Invalid IPv4 address for bandwidth cap")
            qos.setdefault("caps", []).append({"ip": cap_ip, "mbps": cap_mb})
            add_audit(conn, uname, "ping_cap_add", f"{cap_ip}={cap_mb}M", ip)
        if payload.get("del_cap") is not None:
            idx = int(payload["del_cap"])
            caps = qos.get("caps", [])
            if 0 <= idx < len(caps):
                removed = caps.pop(idx)
                add_audit(conn, uname, "ping_cap_del", f"{removed.get('ip')}", ip)
        set_setting(conn, "qos_json", json.dumps(qos))
        ETC_DIR.mkdir(parents=True, exist_ok=True)
        QOS_CONF.write_text(json.dumps(qos, indent=2), encoding="utf-8")
        qos_script = INSTALL_DIR / "services" / "qos" / "alyan-qos.sh"
        if qos.get("enabled"):
            if qos_script.exists():
                subprocess.run(["bash", str(qos_script), "apply"], stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "start", "alyan-qos"], stderr=subprocess.DEVNULL)
            add_audit(conn, uname, "ping_apply", f"{qos.get('iface')} @ {qos.get('bw_mbps')}M ({qos.get('preset')})", ip)
        else:
            if qos_script.exists():
                subprocess.run(["bash", str(qos_script), "stop"], stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "stop", "alyan-qos"], stderr=subprocess.DEVNULL)
            add_audit(conn, uname, "ping_disable", "Ping Stability disabled", ip)

    if isinstance(payload.get("bot"), dict):
        bot = json.loads(get_setting(conn, "bot_json", '{"enabled":false,"token":"","admin_id":"","alerts":true}'))
        bot.update(payload["bot"])
        set_setting(conn, "bot_json", json.dumps(bot))
        ETC_DIR.mkdir(parents=True, exist_ok=True)
        BOT_CONF.write_text(json.dumps(bot, indent=2), encoding="utf-8")
        os.chmod(BOT_CONF, 0o600)
        if bot.get("enabled") and bot.get("token"):
            subprocess.run(["systemctl", "enable", "alyan-bot"], stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "restart", "alyan-bot"], stderr=subprocess.DEVNULL)
        else:
            subprocess.run(["systemctl", "stop", "alyan-bot"], stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "disable", "alyan-bot"], stderr=subprocess.DEVNULL)
        add_audit(conn, uname, "bot_config", f"enabled={bool(bot.get('enabled'))}", ip)

    if payload.get("maint") == "fix_ws_ssl_stack":
        ensure_self_signed_ssl(get_setting(conn, "domain", "localhost"))
        render_all_configs(conn, reload_daemons=True)
        add_audit(conn, uname, "stack_repair", "SSH-WS + SSL + HAProxy + Nginx + Xray repaired", ip)
        need_render = False

    conn.commit()

    if need_render:
        ensure_self_signed_ssl(get_setting(conn, "domain", "localhost"))
        render_all_configs(conn, reload_daemons=True)

    if need_ssl:
        try:
            issue_ssl(conn, standalone=False)
            add_audit(conn, uname, "ssl_renew", get_setting(conn, "domain", ""), ip)
            conn.commit()
        except Exception:
            pass

    return {"ok": True, "cfg": build_cfg_dict(conn)}


def send_telegram_test(conn: sqlite3.Connection) -> dict:
    bot = json.loads(get_setting(conn, "bot_json", "{}"))
    token = (bot.get("token") or "").strip()
    admin_ids = [x.strip() for x in str(bot.get("admin_id") or "").split(",") if x.strip()]
    if not token or not admin_ids:
        raise ValueError("Save your BotFather token and Admin ID first")
    domain = get_setting(conn, "domain", "localhost")
    sent = 0
    for cid in admin_ids:
        data = json.dumps(
            {
                "chat_id": cid,
                "text": f"🔥 *Alyan Webpanel Connected!*\nHost: `{domain}`\nStatus: Online & Ready (`menu` / `/start`)",
                "parse_mode": "Markdown",
            }
        ).encode("utf-8")
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{token}/sendMessage",
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=6) as resp:
            resp.read()
            sent += 1
    return {"ok": True, "sent": sent}


def init_system(conn: sqlite3.Connection, domain: str, panel_port: int, iface: str, pub_ip: str) -> dict:
    ETC_DIR.mkdir(parents=True, exist_ok=True)
    VAR_DIR.mkdir(parents=True, exist_ok=True)

    set_setting(conn, "domain", domain.strip().lower())
    set_setting(conn, "panel_port", str(panel_port))
    set_setting(conn, "iface", iface.strip() or "eth0")
    set_setting(conn, "ip", pub_ip.strip() or "127.0.0.1")

    # Fetch Geo / ISP details cleanly
    if not get_setting(conn, "provider"):
        loc, prov = "Cloud Edge", "Dedicated VPS"
        try:
            url = f"http://ip-api.com/json/{pub_ip}?fields=status,countryCode,city,isp,org"
            with urllib.request.urlopen(url, timeout=3) as resp:
                geo = json.loads(resp.read().decode("utf-8", errors="ignore"))
                if geo.get("status") == "success":
                    city = geo.get("city") or ""
                    cc = geo.get("countryCode") or ""
                    loc = f"{city}, {cc}".strip(", ") or loc
                    prov = geo.get("isp") or geo.get("org") or prov
        except Exception:
            pass
        set_setting(conn, "location", loc)
        set_setting(conn, "provider", prov)

    if not get_setting(conn, "banner"):
        default_banner = (
            "<font color='#ff2d2d'><b>⚡ ALYAN FLAME NETWORK ⚡</b></font><br>"
            "<font color='#ffb000'>Ultra-Low Latency SSH · WS (/alyan) · TLS 1.3</font><br>"
            "<font color='#9a94a6'>No Torrent · No Spam · Multi-Login Monitored</font>"
        )
        set_setting(conn, "banner", default_banner)

    if not get_setting(conn, "qos_json"):
        qos_init = {"enabled": True, "iface": iface or "eth0", "bw_mbps": 500, "preset": "gaming", "caps": []}
        set_setting(conn, "qos_json", json.dumps(qos_init))
        QOS_CONF.write_text(json.dumps(qos_init, indent=2), encoding="utf-8")

    if not get_setting(conn, "bot_json"):
        bot_init = {"enabled": False, "token": "", "admin_id": "", "alerts": True}
        set_setting(conn, "bot_json", json.dumps(bot_init))
        BOT_CONF.write_text(json.dumps(bot_init, indent=2), encoding="utf-8")
        os.chmod(BOT_CONF, 0o600)

    if not get_setting(conn, "speedtest_json"):
        st_init = {"ping": 0.0, "jitter": 0.0, "down": 0.0, "up": 0.0, "isp": get_setting(conn, "provider", "Dedicated VPS"), "ran": "Not tested yet"}
        set_setting(conn, "speedtest_json", json.dumps(st_init))

    # Ensure primary Super Admin exists
    adm = conn.execute("SELECT 1 FROM admins WHERE username = 'admin'").fetchone()
    if not adm:
        alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"
        init_pw = "".join(secrets.choice(alphabet) for _ in range(12))
        CREDS_FILE.write_text(init_pw + "\n", encoding="utf-8")
        os.chmod(CREDS_FILE, 0o600)
        conn.execute(
            """
            INSERT INTO admins (username, pass_hash, role, max_accounts, scope, status, last_login, created)
            VALUES ('admin', ?, 'super', 0, 'all', 'active', 'Never', ?)
            """,
            (hash_password(init_pw), dt.date.today().isoformat()),
        )
        add_audit(conn, "installer", "system_init", f"domain={domain} port={panel_port}", "local")

    conn.commit()
    ensure_self_signed_ssl(domain)
    render_all_configs(conn, reload_daemons=False)
    return {"ok": True, "domain": domain, "panel_port": panel_port}


